# Copy to .env and fill in. Never commit .env.
# USDC recipient for query payments (your wallet on Base Sepolia).
PAY_TO=0x0000000000000000000000000000000000000000

# Price per oracle query, in USDC (human units).
PRICE_USDC=0.05

# Gateway listen port.
PORT=4021

# x402 payment network. Base Sepolia for the demo.
X402_NETWORK=eip155:84532
X402_CHAIN_ID=84532
# Base Sepolia USDC (faucet: faucet.circle.com)
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Challenge validity window in seconds.
X402_MAX_TIMEOUT=600

# Where the CRE workflow simulator listens (cre workflow simulate --listen).
CRE_SIMULATOR_URL=http://localhost:2000
